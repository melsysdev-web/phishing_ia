# Copia este archivo a .env y completa los valores reales.
# .env nunca se commitea (ver .gitignore).

VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
FACT_CHECK_API_KEY=

# Clave de autenticación para el backend (dejar vacío = sin autenticación)
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# development | production. En production, el backend rehúsa arrancar si
# API_KEY está vacío (ver backend/app/main.py).
ENVIRONMENT=development

# Orígenes CORS adicionales separados por coma (ej: https://mi-app.com)
ALLOWED_ORIGINS=

# Ruta a la carpeta de modelos. Solo hace falta en despliegue (Docker); en
# local se auto-detecta como <repo>/models si se deja vacío.
MODELS_DIR=

# IPs desde las que uvicorn confía en el header X-Forwarded-For para saber
# la IP real del visitante (ver backend/Dockerfile). Dejar vacío en local.
# En Render, poner "*" — el contenedor solo es alcanzable a través del
# proxy de Render, así que confiar en cualquier IP conectante es seguro ahí.
FORWARDED_ALLOW_IPS=
